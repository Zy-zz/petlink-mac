{
  "name": "petlink-mac",
  "productName": "PetLink",
  "version": "0.5.0",
  "private": true,
  "description": "Send a little company to a friend's desktop.",
  "license": "MIT",
  "scripts": {
    "start": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && node --test test/peer.test.cjs test/pet-drag.test.cjs",
    "test:interop": "node test/rust-interop.cjs",
    "test:ui": "node test/native-ui.cjs",
    "build:mac": "bash scripts/build-mac.sh",
    "build:mac:release": "bash scripts/build-mac.sh --release",
    "test:public": "node test/rust-public-relay.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@noble/curves": "2.0.1",
    "nostr-tools": "^2.17.0",
    "ws": "^8.18.3"
  }
}
